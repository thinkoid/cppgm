  block ^loop_preheader_6:
    %t23 = phi i32 [^loop_preheader_1: 0, ^loop_preheader_2: 0, ^loop_exit_5: %t20]
    %t24 = convert sext i64 i32 %t23
    jump ^for_body_7

  block ^for_body_7:
