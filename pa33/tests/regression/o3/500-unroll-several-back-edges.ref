function @marks(%v : ptr, %below : ptr, %same : ptr, %x : i32) -> void [no_inline=yes] {
  block ^entry:
    %t1 = index inbounds i32 [projection=array_element] %v, 1
    %t2 = load typed i32 %t1
    %t3 = index inbounds i32 [projection=array_element] %v, 2
    %t4 = load typed i32 %t3
    %t5 = cmp lt i32 %t2, %t4
    branch %t5, ^unrolled_1, ^unrolled_2

  block ^unrolled_1:
    %t6 = index inbounds i32 [projection=array_element] %v, 2
    %t7 = load typed i32 %below
    %t8 = binary add i32 %t7, 1
    store typed i32 %t8, %below
    %t9 = load typed i32 %t6
    jump ^unrolled_4

  block ^unrolled_2:
    %t10 = cmp eq i32 %x, %t2
    branch %t10, ^unrolled_3, ^unrolled_4

  block ^unrolled_3:
    %t11 = index inbounds i32 [projection=array_element] %v, 2
    %t12 = load typed i32 %same
    %t13 = binary add i32 %t12, 1
    store typed i32 %t13, %same
    %t14 = load typed i32 %t11
    jump ^unrolled_4

  block ^unrolled_4:
    %t15 = phi i32 [^unrolled_1: %t9, ^unrolled_2: %t4, ^unrolled_3: %t14]
    %t16 = index inbounds i32 [projection=array_element] %v, 3
    %t17 = load typed i32 %t16
    %t18 = cmp lt i32 %t15, %t17
    branch %t18, ^unrolled_5, ^unrolled_6

  block ^unrolled_5:
    %t19 = index inbounds i32 [projection=array_element] %v, 3
    %t20 = load typed i32 %below
    %t21 = binary add i32 %t20, 1
    store typed i32 %t21, %below
    %t22 = load typed i32 %t19
    jump ^unrolled_8

  block ^unrolled_6:
    %t23 = cmp eq i32 %x, %t15
    branch %t23, ^unrolled_7, ^unrolled_8

  block ^unrolled_7:
    %t24 = index inbounds i32 [projection=array_element] %v, 3
    %t25 = load typed i32 %same
    %t26 = binary add i32 %t25, 1
    store typed i32 %t26, %same
    %t27 = load typed i32 %t24
    jump ^unrolled_8

  block ^unrolled_8:
    %t28 = phi i32 [^unrolled_5: %t22, ^unrolled_6: %t17, ^unrolled_7: %t27]
    %t29 = index inbounds i32 [projection=array_element] %v, 4
    %t30 = load typed i32 %t29
    %t31 = cmp lt i32 %t28, %t30
    branch %t31, ^unrolled_9, ^unrolled_10

  block ^unrolled_9:
    %t32 = load typed i32 %below
    %t33 = binary add i32 %t32, 1
    store typed i32 %t33, %below
    jump ^unrolled_12

  block ^unrolled_10:
    %t34 = cmp eq i32 %x, %t28
    branch %t34, ^unrolled_11, ^unrolled_12

  block ^unrolled_11:
    %t35 = load typed i32 %same
    %t36 = binary add i32 %t35, 1
    store typed i32 %t36, %same
    jump ^unrolled_12

  block ^unrolled_12:
    return void
}
function @weights(%v : ptr, %x : i32) -> i32 [no_inline=yes] {
  block ^entry:
    %t1 = load typed i32 %v
    %t2 = cmp lt i32 %t1, %x
    branch %t2, ^unrolled_1, ^unrolled_2

  block ^unrolled_1:
    store typed i32 1, %v
    jump ^split_4

  block ^unrolled_2:
    %t3 = cmp eq i32 %x, %t1
    branch %t3, ^unrolled_3, ^split_4

  block ^unrolled_3:
    store typed i32 2, %v
    jump ^split_4

  block ^split_4:
    %t4 = phi i32 [^unrolled_1: 3, ^unrolled_2: 0, ^unrolled_3: 5]
    %t5 = index inbounds i32 [projection=array_element] %v, 1
    %t6 = load typed i32 %t5
    %t7 = cmp lt i32 %t6, %x
    branch %t7, ^unrolled_5, ^unrolled_6

  block ^unrolled_5:
    %t8 = index inbounds i32 [projection=array_element] %v, 1
    store typed i32 1, %t8
    %t9 = binary add i32 %t4, 3
    jump ^split_8

  block ^unrolled_6:
    %t10 = cmp eq i32 %x, %t6
    branch %t10, ^unrolled_7, ^split_8

  block ^unrolled_7:
    %t11 = index inbounds i32 [projection=array_element] %v, 1
    store typed i32 2, %t11
    %t12 = binary xor i32 %t4, 5
    jump ^split_8

  block ^split_8:
    %t13 = phi i32 [^unrolled_5: %t9, ^unrolled_6: %t4, ^unrolled_7: %t12]
    %t14 = index inbounds i32 [projection=array_element] %v, 2
    %t15 = load typed i32 %t14
    %t16 = cmp lt i32 %t15, %x
    branch %t16, ^unrolled_9, ^unrolled_10

  block ^unrolled_9:
    %t17 = index inbounds i32 [projection=array_element] %v, 2
    store typed i32 1, %t17
    %t18 = binary add i32 %t13, 3
    jump ^split_12

  block ^unrolled_10:
    %t19 = cmp eq i32 %x, %t15
    branch %t19, ^unrolled_11, ^split_12

  block ^unrolled_11:
    %t20 = index inbounds i32 [projection=array_element] %v, 2
    store typed i32 2, %t20
    %t21 = binary xor i32 %t13, 5
    jump ^split_12

  block ^split_12:
    %t22 = phi i32 [^unrolled_9: %t18, ^unrolled_10: %t13, ^unrolled_11: %t21]
    %t23 = index inbounds i32 [projection=array_element] %v, 3
    %t24 = load typed i32 %t23
    %t25 = cmp lt i32 %t24, %x
    branch %t25, ^unrolled_13, ^unrolled_14

  block ^unrolled_13:
    %t26 = index inbounds i32 [projection=array_element] %v, 3
    store typed i32 1, %t26
    %t27 = binary add i32 %t22, 3
    jump ^split_16

  block ^unrolled_14:
    %t28 = cmp eq i32 %x, %t24
    branch %t28, ^unrolled_15, ^split_16

  block ^unrolled_15:
    %t29 = index inbounds i32 [projection=array_element] %v, 3
    store typed i32 2, %t29
    %t30 = binary xor i32 %t22, 5
    jump ^split_16

  block ^split_16:
    %t31 = phi i32 [^unrolled_13: %t27, ^unrolled_14: %t22, ^unrolled_15: %t30]
    return i32 %t31
}
function @uncounted(%v : ptr, %below : ptr, %same : ptr, %x : i32, %count : i64) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^low: %next, ^rest: %next, ^equal: %next]
    %more = cmp ult i64 %i, %count
    branch %more, ^body, ^done

  block ^body:
    %p = index inbounds i32 [projection=array_element] %v, %i
    %a = load typed i32 %p
    %next = binary add i64 %i, 1
    %lt = cmp lt i32 %a, %x
    branch %lt, ^low, ^rest

  block ^low:
    %c = load typed i32 %below
    %c1 = binary add i32 %c, 1
    store typed i32 %c1, %below
    jump ^head

  block ^rest:
    %eq = cmp eq i32 %x, %a
    branch %eq, ^equal, ^head

  block ^equal:
    %d = load typed i32 %same
    %d1 = binary add i32 %d, 1
    store typed i32 %d1, %same
    jump ^head

  block ^done:
    return void
}
function @long_run(%v : ptr, %below : ptr, %same : ptr, %x : i32) -> void [no_inline=yes] {
  block ^entry:
    jump ^head

  block ^head:
    %i = phi i64 [^entry: 0, ^low: %next, ^rest: %next, ^equal: %next]
    %more = cmp ult i64 %i, 40
    branch %more, ^body, ^done

  block ^body:
    %p = index inbounds i32 [projection=array_element] %v, %i
    %a = load typed i32 %p
    %next = binary add i64 %i, 1
    %lt = cmp lt i32 %a, %x
    branch %lt, ^low, ^rest

  block ^low:
    %c = load typed i32 %below
    %c1 = binary add i32 %c, 1
    store typed i32 %c1, %below
    jump ^head

  block ^rest:
    %eq = cmp eq i32 %x, %a
    branch %eq, ^equal, ^head

  block ^equal:
    %d = load typed i32 %same
    %d1 = binary add i32 %d, 1
    store typed i32 %d1, %same
    jump ^head

  block ^done:
    return void
}
