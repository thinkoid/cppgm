function @unsigned_words(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    branch %n, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t1 = cmp uge i64 %n, 4
    branch %t1, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t2 = binary add i64 %n, -4
    %t3 = vector fromi64 4985484787499139072
    %t4 = vector pshufd %t3, 68
    %t5 = vector fromi64 4841369599423283200
    %t6 = vector pshufd %t5, 68
    %t7 = vector fromi64 4294967295
    %t8 = vector pshufd %t7, 68
    %t9 = vector fromi64 4985484787500187648
    %t10 = vector pshufd %t9, 68
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t11 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t31]
    %t12 = index i64 %x, %t11
    %t13 = load v128 %t12
    %t14 = vector psrlqi %t13, 32
    %t15 = vector por %t14, %t4
    %t16 = vector pand %t13, %t8
    %t17 = vector por %t16, %t6
    %t18 = vector subpd %t15, %t10
    %t19 = vector addpd %t18, %t17
    %t20 = index f64 %d, %t11
    store v128 %t19, %t20
    %t21 = binary add nowrap i64 %t11, 2
    %t22 = index i64 %x, %t21
    %t23 = load v128 %t22
    %t24 = vector psrlqi %t23, 32
    %t25 = vector por %t24, %t4
    %t26 = vector pand %t23, %t8
    %t27 = vector por %t26, %t6
    %t28 = vector subpd %t25, %t10
    %t29 = vector addpd %t28, %t27
    %t30 = index f64 %d, %t21
    store v128 %t29, %t30
    %t31 = binary add nowrap i64 %t11, 4
    %t32 = cmp ule i64 %t31, %t2
    branch %t32, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t33 = cmp ult i64 %t31, %n
    branch %t33, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t34 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t31]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t34, ^body: %next]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %r = convert uitofp f64 i64 %v
    %o = index f64 %d, %i
    store typed f64 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @signed_words(%d : ptr, %x : ptr, %n : i64) -> void [no_inline=yes] {
  block ^entry:
    branch %n, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t1 = cmp uge i64 %n, 4
    branch %t1, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t2 = binary add i64 %n, -4
    %t3 = vector fromi64 -9223372036854775808
    %t4 = vector pshufd %t3, 68
    %t5 = vector fromi64 4985484787499139072
    %t6 = vector pshufd %t5, 68
    %t7 = vector fromi64 4841369599423283200
    %t8 = vector pshufd %t7, 68
    %t9 = vector fromi64 4294967295
    %t10 = vector pshufd %t9, 68
    %t11 = vector fromi64 4985484789647671296
    %t12 = vector pshufd %t11, 68
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t13 = phi i64 [^loop_preheader_2: 0, ^wide_loop_3: %t35]
    %t14 = index i64 %x, %t13
    %t15 = load v128 %t14
    %t16 = vector pxor %t15, %t4
    %t17 = vector psrlqi %t16, 32
    %t18 = vector por %t17, %t6
    %t19 = vector pand %t16, %t10
    %t20 = vector por %t19, %t8
    %t21 = vector subpd %t18, %t12
    %t22 = vector addpd %t21, %t20
    %t23 = index f64 %d, %t13
    store v128 %t22, %t23
    %t24 = binary add nowrap i64 %t13, 2
    %t25 = index i64 %x, %t24
    %t26 = load v128 %t25
    %t27 = vector pxor %t26, %t4
    %t28 = vector psrlqi %t27, 32
    %t29 = vector por %t28, %t6
    %t30 = vector pand %t27, %t10
    %t31 = vector por %t30, %t8
    %t32 = vector subpd %t29, %t12
    %t33 = vector addpd %t32, %t31
    %t34 = index f64 %d, %t24
    store v128 %t33, %t34
    %t35 = binary add nowrap i64 %t13, 4
    %t36 = cmp ule i64 %t35, %t2
    branch %t36, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t37 = cmp ult i64 %t35, %n
    branch %t37, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t38 = phi i64 [^loop_preheader_1: 0, ^loop_exit_4: %t35]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t38, ^body: %next]
    %p = index i64 %x, %i
    %v = load typed i64 %p
    %r = convert sitofp f64 i64 %v
    %o = index f64 %d, %i
    store typed f64 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
function @places(%d : ptr, %n : i64, %whole : f64) -> void [no_inline=yes] {
  block ^entry:
    %any = cmp ugt i64 %n, 1
    branch %any, ^loop_preheader_1, ^done

  block ^loop_preheader_1:
    %t2 = binary sub i64 %n, 1
    %t3 = cmp uge i64 %t2, 4
    %t4 = binary and i64 %any, %t3
    %parts = convert uitofp f64 i64 %n
    branch %t4, ^loop_preheader_2, ^loop_preheader_5

  block ^loop_preheader_2:
    %t6 = binary add i64 %n, -4
    %t7 = vector pzero
    %t8 = vector fromi64 1
    %t9 = vector punpcklqdq %t7, %t8
    %t10 = vector pshufd %t8, 68
    %t11 = vector paddq %t10, %t9
    %t12 = vector fromi64 4985484787499139072
    %t13 = vector pshufd %t12, 68
    %t14 = vector fromi64 4841369599423283200
    %t15 = vector pshufd %t14, 68
    %t16 = vector fromi64 4294967295
    %t17 = vector pshufd %t16, 68
    %t18 = vector fromi64 4985484787500187648
    %t19 = vector pshufd %t18, 68
    %t20 = vector fromf64 %whole
    %t21 = vector pshufd %t20, 68
    %t22 = vector fromf64 %parts
    %t23 = vector pshufd %t22, 68
    %t24 = vector fromi64 2
    %t25 = vector pshufd %t24, 68
    %t26 = vector fromi64 4
    %t27 = vector pshufd %t26, 68
    jump ^wide_loop_3

  block ^wide_loop_3:
    %t28 = phi v128 [^loop_preheader_2: %t11, ^wide_loop_3: %t53]
    %t29 = phi i64 [^loop_preheader_2: 1, ^wide_loop_3: %t52]
    %t30 = vector psubq %t28, %t10
    %t31 = vector psrlqi %t30, 32
    %t32 = vector por %t31, %t13
    %t33 = vector pand %t30, %t17
    %t34 = vector por %t33, %t15
    %t35 = vector subpd %t32, %t19
    %t36 = vector addpd %t35, %t34
    %t37 = vector mulpd %t21, %t36
    %t38 = vector divpd %t37, %t23
    %t39 = index f64 %d, %t29
    %t40 = vector paddq %t28, %t25
    %t41 = vector psubq %t40, %t10
    %t42 = vector pand %t41, %t17
    %t43 = vector por %t42, %t15
    %t44 = vector psrlqi %t41, 32
    %t45 = vector por %t44, %t13
    %t46 = vector subpd %t45, %t19
    %t47 = vector addpd %t46, %t43
    %t48 = vector mulpd %t21, %t47
    %t49 = vector divpd %t48, %t23
    store v128 %t38, %t39
    %t50 = binary add nowrap i64 %t29, 2
    %t51 = index f64 %d, %t50
    store v128 %t49, %t51
    %t52 = binary add nowrap i64 %t29, 4
    %t53 = vector paddq %t28, %t27
    %t54 = cmp ule i64 %t52, %t6
    branch %t54, ^wide_loop_3, ^loop_exit_4

  block ^loop_exit_4:
    %t55 = cmp ult i64 %t52, %n
    branch %t55, ^loop_preheader_5, ^done

  block ^loop_preheader_5:
    %t56 = phi i64 [^loop_preheader_1: 1, ^loop_exit_4: %t52]
    jump ^body

  block ^body:
    %i = phi i64 [^loop_preheader_5: %t56, ^body: %next]
    %before = binary sub i64 %i, 1
    %place = convert uitofp f64 i64 %before
    %share = binary mul f64 %whole, %place
    %r = binary div f64 %share, %parts
    %o = index f64 %d, %i
    store typed f64 %r, %o
    %next = binary add i64 %i, 1
    %c = cmp ult i64 %next, %n
    branch %c, ^body, ^done

  block ^done:
    return void
}
