declare function @dispose(%p : ptr) -> void [linkage=c, binding=strong, object=dispose]

function @release(%owner : ptr) -> void {
  block ^entry:
    %word = load typed i64 %owner
    %shared = binary and i64 %word, 1
    branch %shared, ^counted, ^done

  block ^counted:
    %bits = binary and i64 %word, -4
    %object = copy ptr %bits
    %count = index i8 %object, 8
    %left = atomic_add_fetch i64 %count, -1, 5
    %last = cmp eq i64 %left, 0
    branch %last, ^drop, ^done

  block ^drop:
    call void @dispose(%object)
    jump ^done

  block ^done:
    return void
}
function @step_first(%count : ptr) -> void {
  block ^entry:
    %left = atomic_add_fetch i64 %count, -1, 5
    %last = cmp eq i64 %left, 0
    branch %last, ^drop, ^done

  block ^drop:
    call void @dispose(%count)
    jump ^done

  block ^done:
    return void
}
function @three(%a : ptr, %b : ptr, %c : ptr) -> void {
  block ^entry:
    %word_1 = load typed i64 %a
    %shared_2 = binary and i64 %word_1, 1
    branch %shared_2, ^counted_1, ^inline_cont_2

  block ^counted_1:
    call void @release(%a)
    jump ^inline_cont_2

  block ^inline_cont_2:
    %word_3 = load typed i64 %b
    %shared_4 = binary and i64 %word_3, 1
    branch %shared_4, ^counted_3, ^inline_cont_4

  block ^counted_3:
    call void @release(%b)
    jump ^inline_cont_4

  block ^inline_cont_4:
    %word_5 = load typed i64 %c
    %shared_6 = binary and i64 %word_5, 1
    branch %shared_6, ^counted_5, ^inline_cont_6

  block ^counted_5:
    call void @release(%c)
    jump ^inline_cont_6

  block ^inline_cont_6:
    return void
}
function @counts(%a : ptr, %b : ptr, %c : ptr) -> void {
  block ^entry:
    call void @step_first(%a)
    call void @step_first(%b)
    call void @step_first(%c)
    return void
}
