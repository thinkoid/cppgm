# Known 32-bit divisors use shifts and multiplies at baseline.
none(idiv) in @signed_quotient
none(idiv) in @signed_remainder
none(idiv) in @negative_quotient
none(div) in @unsigned_quotient
none(div) in @unsigned_max_divisor
none(idiv) in @unsigned_signed_op
none(div) in @signed_unsigned_op
none(idiv) in @from_pointer
# Preserve the existing non-trapping INT_MIN / -1 behavior.
none(idiv.i32) in @negative_one
none(idiv.i32) in @dynamic
