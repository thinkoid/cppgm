machine_ir x86_64 linux

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @heap
  storage data
  item i64 3
  item i64 5
  item i64 8
  item i64 13
  item i64 21
  item i64 34
  item i64 55
  item i64 89

global @letters
  storage data
  item i64 5208208757389214273

global @text
  storage data
  item zero 16

global @cursor
  storage scalar ptr
  init ptr 0

global @where
  storage scalar i64
  init i64 0

global @seen
  storage scalar i64
  init i64 0

function @emit
  abi
    param %x -> rdi : i64
    param %out -> rsi : ptr
    return void -> void
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rax, 0

  block ^scan
    lea rcx, [rax*8]
    mov r10, @heap
    load.i64 rcx, [r10+rcx]
    lea rdx, [rax+1]
    cmp.i64 rdi, rcx
    jbe ^found

  block ^scan~scan
    mov rax, rdx
    lea rcx, [rax*8]
    mov r10, @heap
    load.i64 rcx, [r10+rcx]
    lea rdx, [rax+1]
    cmp.i64 rdi, rcx
    ja ^scan~scan

  block ^found
    mov rdx, rsi
    cmp.i64 rcx, rdi
    jne ^join

  block ^hit
    mov rdx, rax
    mov r10, @letters
    load.u8 rdx, [r10+rdx]
    store.u8 [rsi], rdx
    lea rdx, [rsi+1]

  block ^join
    store.u8 [rdx], 0
    store.u8 [rsi+15], 1
    store.ptr @cursor, rdx
    store.i64 @where, rax
    store.i64 @seen, rcx
    ret

function @main
  abi
    return i32 -> rax
  frame
    stack_size 0
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    mov rdi, 13
    mov rsi, @text
    call @emit [args=(rsi,rdi)]
    load.ptr rsi, @cursor
    mov rdi, 14
    call @emit [args=(rsi,rdi)]
    load.ptr rsi, @cursor
    mov rdi, 55
    call @emit [args=(rsi,rdi)]
    load.ptr rax, @cursor
    load.u8 rax, [rax-2]
    load.u8 rcx, @text
    add.u32 rax, rcx
    sub.u32 rax, 100
    zext.i8 rax
    ret rax
