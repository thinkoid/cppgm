    vector.pxor xmm0, xmm0, <xmm1>
    vector.pand xmm0, xmm0, xmm15
    vector.pxor xmm0, xmm0, <xmm1>
    fmul.f32 xmm0, xmm0, 16.0f
    fmul.f32 <xmm0>, <xmm0>, 4.0f
    fadd.f32 xmm0, xmm0, <xmm0>
    fadd.f32 xmm0, xmm0, <xmm1>
    ret xmm0

function @zero_sign
  abi
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    slot $cell -> [rbp-<off0>] : f64

  block ^entry
    call @literals [args=(xmm0,xmm1)]
    fmov.f64 [rbp-<off0>], xmm0
    load.i64 rax, [rbp-<off0>]
    shr rax, 63
    ret rax

function @main
  abi
    return i32 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    temp %nan -> [rbp-<off0>] : f64
    temp %nan32 -> [rbp-<off1>] : f32

  block ^entry
    fmov.f64 xmm0, @nan_bits
    fmov.f64 [rbp-<off0>], xmm0
    fptrunc.f64.f32 xmm1, xmm0
    fmov.f32 [rbp-<off1>], xmm1
