function @two_readers
  abi
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    param %a -> <xmm0> : f64
    param %b -> <xmm1> : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    flt.f64 rax, xmm0, xmm1
    test.u8 rax, rax
    vector.toi64 <gpr0>, <xmm1>
    vector.toi64 <gpr1>, <xmm0>
    cmovne <gpr0>, <gpr1>
    vector.fromi64 xmm0, <gpr0>
    test.u8 rax, rax
    vector.toi64 <gpr0>, <xmm0>
    vector.toi64 <gpr1>, <xmm1>
    cmovne <gpr0>, <gpr1>
    vector.fromi64 xmm1, <gpr0>
    fmul.f64 xmm0, xmm0, 4.0
    fadd.f64 xmm0, xmm0, xmm1
    ret xmm0

