machine_ir x86_64 <host-target>

startup
    call @main [args=()]
    mov rdi, rax
    exit

global @nan_bits
  storage scalar i64
  init i64 9221120237041090560

function @lt_f64
  abi
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    param %a -> <xmm0> : f64
    param %b -> <xmm1> : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 xmm15, xmm0
    vector.cmppd xmm15, xmm15, xmm1, 1
    vector.pxor <xmm0>, <xmm0>, <xmm1>
    vector.pand <xmm0>, <xmm0>, xmm15
    vector.pxor <xmm0>, <xmm0>, <xmm1>
    ret <xmm0>

