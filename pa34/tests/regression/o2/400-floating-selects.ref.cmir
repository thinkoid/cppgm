function @table_f64
  abi
    param %test -> rdi : ptr
    param %nan -> xmm0 : f64
    return i64 -> rax
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated
    preserve <gpr2> <gpr3>
    param-slot %nan -> [rbp-<off0>] : f64

  block ^entry
    mov <gpr2>, rdi
    fmov.f64 [rbp-<off0>], xmm0
    fmov.f64 xmm0, 1.0
    fmov.f64 xmm1, 2.0
    fmov.f64 <xmm0>, 3.0
    fmov.f64 <xmm1>, 5.0
    call *<gpr2> [args=(xmm0,xmm1,<xmm0>,<xmm1>)]
    feq.f64 rax, xmm0, 3.0
    mov <gpr3>, rax
    or <gpr3>, 0
    fmov.f64 xmm0, 2.0
    fmov.f64 xmm1, 1.0
    fmov.f64 <xmm0>, 3.0
    fmov.f64 <xmm1>, 5.0
    call *<gpr2> [args=(xmm0,xmm1,<xmm0>,<xmm1>)]
    feq.f64 rax, xmm0, 3.0
    shl <gpr3>, 1
    or <gpr3>, rax
    fmov.f64 xmm0, 1.0
    fmov.f64 xmm1, 1.0
    fmov.f64 <xmm0>, 3.0
    fmov.f64 <xmm1>, 5.0
    call *<gpr2> [args=(xmm0,xmm1,<xmm0>,<xmm1>)]
    feq.f64 rax, xmm0, 3.0
    shl <gpr3>, 1
    or <gpr3>, rax
    fmov.f64 xmm0, [rbp-<off0>]
    fmov.f64 xmm1, 1.0
    fmov.f64 <xmm0>, 3.0
    fmov.f64 <xmm1>, 5.0
    call *<gpr2> [args=(xmm0,xmm1,<xmm0>,<xmm1>)]
    feq.f64 rax, xmm0, 3.0
    shl <gpr3>, 1
    or <gpr3>, rax
    fmov.f64 xmm0, 1.0
    fmov.f64 xmm1, [rbp-<off0>]
    fmov.f64 <xmm0>, 3.0
    fmov.f64 <xmm1>, 5.0
    call *<gpr2> [args=(xmm0,xmm1,<xmm0>,<xmm1>)]
    feq.f64 rax, xmm0, 3.0
    shl <gpr3>, 1
    or rax, <gpr3>
    ret rax

