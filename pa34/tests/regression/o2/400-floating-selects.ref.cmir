function @literals
  abi
    param %x -> xmm0 : f64
    param %y -> xmm1 : f64
    return f64 -> xmm0
  frame
    stack_size N
    scratch_bytes 0
    frame_pointer keep
    epilogues duplicated

  block ^entry
    fmov.f64 xmm15, xmm0
    vector.cmppd xmm15, xmm15, xmm1, 1
    fmov.f64 xmm14, -0.0
    fmov.f64 xmm0, 3.0
    vector.pxor xmm0, xmm0, xmm14
    vector.pand xmm0, xmm0, xmm15
    vector.pxor xmm0, xmm0, xmm14
    ret xmm0

