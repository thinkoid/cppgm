    vector.cmppd xmm15, xmm15, xmm0, 2
    vector.pxor <xmm0>, <xmm0>, xmm0
    vector.pand <xmm0>, <xmm0>, xmm15
    vector.pxor <xmm0>, <xmm0>, xmm0
